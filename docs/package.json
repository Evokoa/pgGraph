{
  "name": "pggraph-docs-validation",
  "private": true,
  "scripts": {
    "check": "npm run mdx && npm run render && npm run spell",
    "mdx": "node scripts/check-mdx.mjs",
    "render": "node scripts/check-rendered-mdx.mjs",
    "spell": "cspell --no-progress --show-suggestions '**/*.mdx' '../README.md'"
  },
  "devDependencies": {
    "@mdx-js/mdx": "3.1.1",
    "cspell": "^8.19.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
